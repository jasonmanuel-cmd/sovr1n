<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join the Sovr1n Beta — Kern County's Local Marketplace</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 620px;
            width: 100%;
            padding: 44px 40px 40px;
        }
        .header {
            text-align: center;
            margin-bottom: 32px;
        }
        .header .badge {
            display: inline-block;
            background: #e8f0ff;
            color: #0052a3;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 14px;
        }
        .header h1 {
            color: #1a1a2e;
            font-size: 26px;
            font-weight: 700;
            line-height: 1.25;
            margin-bottom: 12px;
        }
        .header .mission {
            color: #444;
            font-size: 15px;
            line-height: 1.6;
            max-width: 480px;
            margin: 0 auto 8px;
        }
        .header .expectation {
            color: #666;
            font-size: 13px;
            line-height: 1.5;
            max-width: 460px;
            margin: 0 auto;
        }
        .divider {
            border: none;
            border-top: 1px solid #eee;
            margin: 28px 0;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 7px;
            color: #222;
            font-weight: 600;
            font-size: 14px;
        }
        label .optional {
            font-weight: 400;
            color: #999;
            font-size: 12px;
            margin-left: 4px;
        }
        input[type="text"],
        input[type="email"],
        select,
        textarea {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            color: #222;
            transition: border-color 0.2s;
            background: #fafafa;
        }
        input[type="text"]:focus,
        input[type="email"]:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #0066cc;
            background: #fff;
        }
        textarea {
            resize: vertical;
            min-height: 90px;
        }
        .help-text {
            font-size: 12px;
            color: #999;
            margin-top: 5px;
        }
        button[type="submit"] {
            width: 100%;
            padding: 15px;
            background: #0066cc;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            margin-top: 8px;
        }
        button[type="submit"]:hover { background: #0052a3; }
        button[type="submit"]:active { transform: scale(0.99); }
        button[type="submit"]:disabled {
            background: #aaa;
            cursor: not-allowed;
        }
        .privacy-note {
            text-align: center;
            font-size: 12px;
            color: #999;
            margin-top: 12px;
        }
        .success {
            display: none;
            background: #e8f5e9;
            border: 2px solid #4caf50;
            color: #2e7d32;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 15px;
            line-height: 1.6;
        }
        .error-msg {
            display: none;
            background: #ffebee;
            border: 2px solid #f44336;
            color: #c62828;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }
        /* QR code section */
        .qr-section {
            margin-top: 36px;
            padding-top: 28px;
            border-top: 1px solid #eee;
            text-align: center;
        }
        .qr-section h3 {
            color: #1a1a2e;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 14px;
        }
        #qrcode {
            display: inline-block;
        }
        #qrcode canvas, #qrcode img {
            border: 6px solid white;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        }
        .qr-url {
            font-size: 12px;
            color: #888;
            margin-top: 10px;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container">

        <div class="header">
            <div class="badge">Kern County Beta — Limited Spots</div>
            <h1>Be First on Sovr1n.<br>Help Build the Local Marketplace.</h1>
            <p class="mission">
                Sovr1n is a local marketplace for Bakersfield and Kern County — connecting shop owners, drivers, and customers for deliveries, listings, and services, all in one place.
            </p>
            <p class="expectation">
                As a beta tester, you'll get early access and a direct line to the team. We ask that you use the app, report what breaks, and tell us what you need. Your feedback shapes what we build next.
            </p>
        </div>

        <div class="success" id="success">
            ✅ <strong>You're in!</strong> Thanks for joining the Sovr1n beta.<br>
            We'll reach out soon with next steps and early access details.
        </div>
        <div class="error-msg" id="error"></div>

        <form id="betaForm">
            <div class="form-group">
                <label for="name">Full Name <span style="color:#c00">*</span></label>
                <input type="text" id="name" name="name" placeholder="First and last name" required autocomplete="name">
            </div>

            <div class="form-group">
                <label for="email">Email Address <span style="color:#c00">*</span></label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
            </div>

            <div class="form-group">
                <label for="role">Trade / Business <span style="color:#c00">*</span></label>
                <select id="role" name="role" required>
                    <option value="">— Select what fits you —</option>
                    <option value="customer">I need deliveries or want to buy local</option>
                    <option value="driver">I'm a driver, hauler, or delivery person</option>
                    <option value="shop-owner">I run a shop, stand, farm, or local service</option>
                </select>
                <div class="help-text">Pick the role that best matches how you'll use the app</div>
            </div>

            <div class="form-group">
                <label for="phone">Phone Number <span class="optional">(optional)</span></label>
                <input type="text" id="phone" name="phone" placeholder="(661) 555-0100" autocomplete="tel">
            </div>

            <div class="form-group">
                <label for="problem">Goals / Notes <span style="color:#c00">*</span></label>
                <textarea id="problem" name="problem" placeholder="What are you hoping Sovr1n helps you with? Any context about your work or situation is helpful." required></textarea>
                <div class="help-text">No wrong answers — the more specific, the better</div>
            </div>

            <button type="submit" id="submitBtn">Sign Up for Beta Access</button>
            <p class="privacy-note">No spam. No fees. We'll only contact you about the beta program.</p>
        </form>

        <div class="qr-section">
            <h3>Share this page — scan to sign up</h3>
            <div id="qrcode"></div>
            <p class="qr-url">sovr1n.com/beta-signup</p>
        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        // Generate QR code
        new QRCode(document.getElementById('qrcode'), {
            text: 'https://sovr1n.com/beta-signup',
            width: 160,
            height: 160,
            colorDark: '#1a1a2e',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
        });

        // Form submission
        const form = document.getElementById('betaForm');
        const successEl = document.getElementById('success');
        const errorEl = document.getElementById('error');
        const submitBtn = document.getElementById('submitBtn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting…';
            errorEl.style.display = 'none';

            const data = {
                name: form.name.value.trim(),
                email: form.email.value.trim(),
                role: form.role.value,
                phone: form.phone.value.trim(),
                problem: form.problem.value.trim()
            };

            try {
                const response = await fetch('/api/beta/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    successEl.style.display = 'block';
                    form.style.display = 'none';
                } else {
                    errorEl.textContent = result.error || 'Something went wrong. Please try again.';
                    errorEl.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Sign Up for Beta Access';
                }
            } catch (err) {
                errorEl.textContent = 'Could not reach the server. Check your connection and try again.';
                errorEl.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Sign Up for Beta Access';
            }
        });
    </script>
</body>
</html>
